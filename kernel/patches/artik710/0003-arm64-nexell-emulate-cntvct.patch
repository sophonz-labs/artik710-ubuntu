diff --git a/arch/arm64/kernel/process.c b/arch/arm64/kernel/process.c
index 581f80e9b9b7..a1260a4a43f8 100644
--- a/arch/arm64/kernel/process.c
+++ b/arch/arm64/kernel/process.c
@@ -628,8 +628,14 @@ static void update_cntkctl_el1(struct task_struct *next)
 {
 	struct thread_info *ti = task_thread_info(next);
 
+	/*
+	 * On the Nexell S5P6818 the counter does not run: user space must not
+	 * read it. Its reads trap and get the PWM timer's count (see
+	 * samsung_read_counter64()).
+	 */
 	if (test_ti_thread_flag(ti, TIF_TSC_SIGSEGV) ||
 	    has_erratum_handler(read_cntvct_el0) ||
+	    IS_ENABLED(CONFIG_ARCH_NEXELL) ||
 	    (IS_ENABLED(CONFIG_ARM64_ERRATUM_1418040) &&
 	     this_cpu_has_cap(ARM64_WORKAROUND_1418040) &&
 	     is_compat_thread(ti)))
diff --git a/arch/arm64/mm/proc.S b/arch/arm64/mm/proc.S
index 22866b49be37..124c80f0a9fd 100644
--- a/arch/arm64/mm/proc.S
+++ b/arch/arm64/mm/proc.S
@@ -489,6 +489,10 @@ SYM_FUNC_START(__cpu_setup)
 	msr	mdscr_el1, x1			// access to the DCC from EL0
 	reset_pmuserenr_el0 x1			// Disable PMU access from EL0
 	reset_amuserenr_el0 x1			// Disable AMU access from EL0
+#ifdef CONFIG_ARCH_NEXELL
+	msr	cntkctl_el1, xzr		// S5P6818: the counter does not run,
+						// trap its reads from EL0
+#endif
 
 	/*
 	 * Default values for VMSA control registers. These will be adjusted
diff --git a/drivers/clocksource/samsung_pwm_timer.c b/drivers/clocksource/samsung_pwm_timer.c
index 3f1a585d1ae9..76d13b54bfed 100644
--- a/drivers/clocksource/samsung_pwm_timer.c
+++ b/drivers/clocksource/samsung_pwm_timer.c
@@ -19,6 +19,8 @@
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/sched_clock.h>
+#include <linux/sched/clock.h>
+#include <linux/math64.h>
 
 #include <clocksource/samsung_pwm.h>
 #if defined(CONFIG_ARM64) && defined(CONFIG_ARCH_NEXELL)
@@ -345,6 +347,21 @@ static u64 notrace samsung_read_sched_clock(void)
 	return samsung_clocksource_read(NULL);
 }
 
+#if defined(CONFIG_ARM64) && defined(CONFIG_ARCH_NEXELL)
+/*
+ * What the kernel uses in place of CNTVCT_EL0, which does not run on the
+ * S5P6818: for get_cycles(), udelay() and the reads of CNTVCT_EL0 by user
+ * space, which trap (update_cntkctl_el1()). They expect a counter of 64 bits
+ * at the rate of the arm,armv8-timer node, and this timer wraps after 32 bits
+ * (43 s). sched_clock() is this timer extended to 64 bits, in ns.
+ */
+static u64 notrace samsung_read_counter64(void)
+{
+	return mul_u64_u32_div(sched_clock(), arch_timer_get_rate(),
+			       NSEC_PER_SEC);
+}
+#endif
+
 static int __init samsung_clocksource_init(void)
 {
 	unsigned long pclk;
@@ -374,11 +391,9 @@ static int __init samsung_clocksource_init(void)
 	 * design (never enabled by firmware; CNTVCT_EL0 reads 0), so arm64's
 	 * get_cycles()/__delay()/udelay() - which read arch_timer_read_counter -
 	 * would hang. Redirect that pointer to this PWM clocksource, mirroring the
-	 * vendor 4.14 BSP (which overrode arch_counter_get_cntvct()). The DT
-	 * arm,armv8-timer clock-frequency MUST equal clock_rate for udelay to be
-	 * correctly scaled.
+	 * vendor 4.14 BSP (which overrode arch_counter_get_cntvct()).
 	 */
-	arch_timer_read_counter = samsung_read_sched_clock;
+	arch_timer_read_counter = samsung_read_counter64;
 #endif
 
 	samsung_clocksource.mask = CLOCKSOURCE_MASK(pwm.variant.bits);
