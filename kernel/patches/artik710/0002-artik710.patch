+/*
+ * S5P6818: root port 2 (index 1) is the HSIC port. Its bit in the Synopsys
+ * INSNREG08 register follows the port power, as in the vendor ehci-exynos.
+ */
+#define NEXELL_EHCI_INSNREG08	0xb0
+#define NEXELL_EHCI_HSIC_PORT	1
+
+static int ehci_platform_port_power(struct usb_hcd *hcd, int portnum,
+				    bool enable)
+{
+	struct ehci_platform_priv *priv = hcd_to_ehci_priv(hcd);
+	u32 val;
+
+	if (!priv->nexell_hsic || portnum != NEXELL_EHCI_HSIC_PORT)
+		return 0;
+
+	val = readl(hcd->regs + NEXELL_EHCI_INSNREG08);
+	if (enable)
+		val |= BIT(portnum);
+	else
+		val &= ~BIT(portnum);
+	writel(val, hcd->regs + NEXELL_EHCI_INSNREG08);
+
+	return 0;
+}
+
