// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung ARTIK710 module on the Raptor carrier (ARTIK 710 developer kit).
 *
 * Module: Nexell S5P6818, 1 GiB RAM, 4 GB eMMC, BCM43455 WiFi/BT, EM358x
 * Zigbee, NXE2000 PMIC. Stock boot chain: bl1, ATF BL31 (PSCI), U-Boot 2016.01.
 */

/dts-v1/;

/* OP-TEE shared memory; inside the range U-Boot reports as RAM. */
/memreserve/ 0x7de00000 0x00100000;

#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/thermal.h>
#include "s5p6818.dtsi"

/ {
	model = "Samsung ARTIK710 Raptor";
	compatible = "samsung,artik710-raptor", "samsung,artik710",
		     "nexell,s5p6818";

	aliases {
		serial0 = &uart0;	/* Zigbee */
		serial1 = &uart1;	/* Bluetooth */
		serial2 = &uart2;
		serial3 = &uart3;	/* debug console */
		serial4 = &uart4;
		/* U-Boot writes the factory MAC (env ethaddr) into this node. */
		ethernet0 = &gmac0;
		/* Numbered as in the stock system: eMMC, SD slot, WiFi. */
		mmc0 = &mmc2;
		mmc1 = &mmc0;
		mmc2 = &mmc1;
		/* Also as in the stock system, which has no bus 3. */
		/* SPI2 is the one on the header: /dev/spidev2.0 as before */
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		i2c0 = &i2c_0;
		i2c1 = &i2c_1;
		i2c2 = &i2c_2;
		i2c4 = &i2c_gpio4;
		i2c5 = &i2c_gpio5;
		i2c6 = &i2c_gpio6;
		i2c7 = &i2c_gpio7;
		i2c8 = &i2c_gpio8;
		i2c9 = &i2c_gpio9;
		i2c10 = &i2c_gpio10;
		i2c11 = &i2c_gpio11;
	};

	chosen {
		stdout-path = "serial3:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x3df00000>;
	};

	/*
	 * The CPU frequencies and voltages of the stock kernel. A chip has a
	 * level from 0 to 4 in its fuses, and the higher the level, the less
	 * voltage it needs: opp-microvolt is for level 0, opp-microvolt-asvN
	 * for level N. The driver s5p6818-cpufreq reads the level.
	 */
	cpu_opp_table: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <1000000>;
			opp-microvolt-asv1 = <1000000>;
			opp-microvolt-asv2 = <1000000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <1025000>;
			opp-microvolt-asv1 = <1000000>;
			opp-microvolt-asv2 = <1000000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <1050000>;
			opp-microvolt-asv1 = <1000000>;
			opp-microvolt-asv2 = <1000000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <1075000>;
			opp-microvolt-asv1 = <1025000>;
			opp-microvolt-asv2 = <1000000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <1100000>;
			opp-microvolt-asv1 = <1050000>;
			opp-microvolt-asv2 = <1000000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
			/* The boot loader runs at this one: set for a restart. */
			opp-suspend;
		};

		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <1125000>;
			opp-microvolt-asv1 = <1075000>;
			opp-microvolt-asv2 = <1025000>;
			opp-microvolt-asv3 = <1000000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <1150000>;
			opp-microvolt-asv1 = <1100000>;
			opp-microvolt-asv2 = <1050000>;
			opp-microvolt-asv3 = <1025000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-1100000000 {
			opp-hz = /bits/ 64 <1100000000>;
			opp-microvolt = <1175000>;
			opp-microvolt-asv1 = <1125000>;
			opp-microvolt-asv2 = <1075000>;
			opp-microvolt-asv3 = <1050000>;
			opp-microvolt-asv4 = <1000000>;
			clock-latency-ns = <100000>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <1225000>;
			opp-microvolt-asv1 = <1175000>;
			opp-microvolt-asv2 = <1125000>;
			opp-microvolt-asv3 = <1075000>;
			opp-microvolt-asv4 = <1025000>;
			clock-latency-ns = <100000>;
		};

		opp-1300000000 {
			opp-hz = /bits/ 64 <1300000000>;
			opp-microvolt = <1275000>;
			opp-microvolt-asv1 = <1225000>;
			opp-microvolt-asv2 = <1175000>;
			opp-microvolt-asv3 = <1125000>;
			opp-microvolt-asv4 = <1075000>;
			clock-latency-ns = <100000>;
		};

		opp-1400000000 {
			opp-hz = /bits/ 64 <1400000000>;
			opp-microvolt = <1325000>;
			opp-microvolt-asv1 = <1275000>;
			opp-microvolt-asv2 = <1225000>;
			opp-microvolt-asv3 = <1175000>;
			opp-microvolt-asv4 = <1125000>;
			clock-latency-ns = <100000>;
		};
	};

	/* The stock system sets this pin with the EHCI and leaves it high. */
	regulator-usb-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-host-vbus";
		gpio = <&gpio_a 16 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	/* On while the OTG port is a host. */
	usb_otg_vbus: regulator-usb-otg-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-otg-vbus";
		gpio = <&gpio_a 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_pins>;

		key-power {
			label = "Power";
			gpios = <&alive_0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-wakeup {
			label = "Wakeup";
			gpios = <&alive_0 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WAKEUP>;
			wakeup-source;
		};
	};

	/*
	 * The I2C buses on GPIOs, with the pins and the timing of the stock
	 * system. What is on them: 4 the USB hub, 6 the audio codec, 7 the
	 * HDMI DDC, 10 the PMIC; 5, 8 and 9 are for chips that this board does
	 * not have (RTC, fuel gauge, charger).
	 */
	i2c_gpio4: i2c-4 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_b 30 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_b 31 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* USB3503 on the HSIC port; the USB sockets are behind it. */
		usb-hub@8 {
			compatible = "smsc,usb3503";
			reg = <0x08>;
			intn-gpios = <&gpio_b 23 GPIO_ACTIVE_HIGH>;
			connect-gpios = <&gpio_a 18 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio_a 22 GPIO_ACTIVE_LOW>;
			initial-mode = <1>;	/* hub */
		};
	};

	i2c_gpio5: i2c-5 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_d 31 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_e 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <100>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c_gpio6: i2c-6 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_a 5 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_a 4 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * ALC5658, as the stock system has it. Untested: on the board
		 * that this file was written with, no chip answers here, in
		 * the stock system either.
		 */
		rt5658: audio-codec@1a {
			compatible = "realtek,rt5658";
			reg = <0x1a>;
			#sound-dai-cells = <0>;
		};
	};

	i2c_gpio7: i2c-7 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_a 24 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_a 23 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <100>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c_gpio8: i2c-8 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_a 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_a 9 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c_gpio9: i2c-9 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_a 19 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_a 20 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c_gpio10: i2c-10 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_c 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_c 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * NXE2000: the registers of the Ricoh RC5T619. Only the rail
		 * of the CPUs is described, for the frequency scaling: the
		 * boot loader switches all rails on, and with the voltages
		 * that the stock system has.
		 */
		pmic@32 {
			compatible = "ricoh,rc5t619";
			reg = <0x32>;
			interrupt-parent = <&alive_0>;
			interrupts = <5 IRQ_TYPE_LEVEL_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&pmic_irq_pin>;
			system-power-controller;

			regulators {
				vdd_cpu: DCDC1 {
					regulator-name = "vdd_cpu";
					/* the lowest and the highest voltage of the table */
					regulator-min-microvolt = <1000000>;
					regulator-max-microvolt = <1325000>;
					/* the stock kernel waits this long after the largest step */
					regulator-settling-time-up-us = <102>;
					regulator-always-on;
					regulator-boot-on;
				};
			};
		};
	};

	i2c_gpio11: i2c-11 {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio_b 18 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio_b 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/* Sound over HDMI: the S/PDIF transmitter feeds the HDMI block. */
	spdif_dit: spdif-dit {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	sound-hdmi {
		compatible = "simple-audio-card";
		simple-audio-card,name = "S5P6818-HDMI";

		simple-audio-card,cpu {
			sound-dai = <&spdiftx>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_dit>;
		};
	};

	/*
	 * The audio jacks: I2S0 and the codec. A card of its own, so that the
	 * sound over HDMI does not depend on the codec.
	 */
	sound-codec {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ARTIK710-RT5658";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,bitclock-master = <&codec_cpu>;
		simple-audio-card,frame-master = <&codec_cpu>;
		simple-audio-card,widgets = "Headphone", "Out Jack",
					    "Microphone", "In Jack";
		simple-audio-card,routing = "Out Jack", "HPOL",
					    "Out Jack", "HPOR",
					    "IN2P", "In Jack";

		codec_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s0 0>;
		};

		simple-audio-card,codec {
			sound-dai = <&rt5658>;
		};
	};
};

/* PLL1 is the clock of all eight CPUs. */
&cpu0 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu1 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu2 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu3 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu4 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu5 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu6 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

&cpu7 {
	clocks = <&clock_pll 1>;
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&vdd_cpu>;
	#cooling-cells = <2>;
};

/* Slower CPUs at the passive trip, which is at 80 C. */
&cpu_thermal {
	cooling-maps {
		map0 {
			trip = <&cpu_alert>;
			cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

&pinctrl_0 {
	/* Both keys pull the pin to ground. */
	key_pins: key-pins {
		nexell,pins = "alive-0", "alive-1";
		nexell,pin-function = <0>;
		nexell,pin-pull = <1>;
		nexell,pin-strength = <0>;
	};

	pmic_irq_pin: pmic-irq-pin {
		nexell,pins = "alive-5";
		nexell,pin-function = <0>;
		nexell,pin-pull = <1>;
		nexell,pin-strength = <0>;
	};

	/*
	 * Reset (low) and boot mode (low at reset: boot loader) of the Zigbee
	 * chip. Inputs with a pull-up, so the chip runs and both lines stay
	 * free for gpioset.
	 */
	zb_reset_pin: zb-reset-pin {
		nexell,pins = "gpioc-8";
		nexell,pin-function = <1>;	/* GPIO */
		nexell,pin-pull = <1>;
		nexell,pin-strength = <0>;
	};

	zb_boot_pin: zb-boot-pin {
		nexell,pins = "gpioc-28";
		nexell,pin-function = <0>;	/* GPIO */
		nexell,pin-pull = <1>;
		nexell,pin-strength = <0>;
	};
};

/*
 * U-Boot runs the console from a 50 MHz clock. 51.2 MHz (PLL2 / 12) is close
 * enough that earlycon, which keeps U-Boot's divisor, stays readable after the
 * clock driver has retuned the generator.
 */
&uart3_clk {
	clock-frequency = <51200000>;
};

&uart3 {
	status = "okay";
};

/*
 * Zigbee (EM358x), 57600 baud with XON/XOFF. The SoC file has the clock that
 * U-Boot leaves on a console here.
 */
&uart0 {
	clocks = <&uart0_clk>, <&uart0_clk>;
	resets = <&nexell_reset 50>;	/* RESET_ID_UART0 */
	pinctrl-names = "default";
	pinctrl-0 = <&serial0_pins &zb_reset_pin &zb_boot_pin>;
	status = "okay";
};

/* As the other ports: from PLL2 and not from the PLL of the CPUs. */
&uart1_clk {
	clk-input = <0x1004>;
	clock-frequency = <147500000>;
};

/* Bluetooth of the BCM43455, at 3 Mbaud with RTS and CTS */
&uart1 {
	status = "okay";

	bluetooth {
		/* as the same chip on the Raspberry Pi 3B+ and 4 */
		compatible = "brcm,bcm43438-bt";
		shutdown-gpios = <&gpio_d 29 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio_d 30 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&alive_0>;
		interrupts = <4 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
		max-speed = <3000000>;
	};
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&serial2_pins>;
	status = "okay";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&serial4_pins>;
	status = "okay";
};

&i2c_0 {
	status = "okay";
};

&i2c_1 {
	status = "okay";
};

&i2c_2 {
	status = "okay";
};

&gmac0 {
	phy-handle = <&rtl_phy>;
	snps,reset-gpio = <&gpio_a 12 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 10000 30000>;
	status = "okay";
};

&mdio0 {
	rtl_phy: ethernet-phy@3 {	/* RTL8211E */
		reg = <3>;
	};
};

/* eMMC */
&mmc2 {
	compatible = "nexell,s5p6818-dw-mshc";
	clocks = <&sdhc2_clk>, <&sdhc2_clk>;
	resets = <&nexell_reset 41>;	/* RESET_ID_SDMMC2 */
	reset-names = "reset";
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2_cclk &sdmmc2_cmd &sdmmc2_bus4>;
	status = "okay";
};

/* SD slot of the Raptor board */
&mmc0 {
	compatible = "nexell,s5p6818-dw-mshc";
	clocks = <&sdhc0_clk>, <&sdhc0_clk>;
	resets = <&nexell_reset 39>;	/* RESET_ID_SDMMC0 */
	reset-names = "reset";
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_cclk &sdmmc0_cmd &sdmmc0_bus4>;
	/delete-property/ broken-cd;
	cd-gpios = <&gpio_b 16 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&watchdog {
	status = "okay";
};

&adc {
	status = "okay";
};

/* On the header, for user space */
&spi2 {
	cs-gpios = <&gpio_c 10 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		/* spidev wants the name of a chip: this one stands in */
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;

		controller-data {
			samsung,spi-feedback-delay = <0>;
		};
	};
};

/*
 * Outputs 0 to 2, as in the stock system, which has the backlight of a panel
 * on 0 and the clock of the secure element (S3T9MF) on 1. The system timer is
 * another block.
 */
&pwm {
	/* PCLK: the counters were measured to run at 200 MHz / (prescaler + 1) */
	clocks = <&pwm_timer_clk>;
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pins &pwm1_pins &pwm2_pins>;
	samsung,pwm-outputs = <0>, <1>, <2>;
	status = "okay";
};

/* WL_REG_ON of the BCM43455 is GPIOD28 on this module. */
&wifi_pwrseq {
	reset-gpios = <&gpio_d 28 GPIO_ACTIVE_LOW>;
};

/* PLL0 / 8 is the 100 MHz for a card clock of 50 MHz. Not the PLL of the CPUs. */
&sdhc1_clk {
	clk-input = <0x1005>;
};

/* WiFi of the BCM43455 */
&mmc1 {
	compatible = "nexell,s5p6818-dw-mshc";
	clocks = <&sdhc1_clk>, <&sdhc1_clk>;
	status = "okay";
};

/* The chip raises ALIVE3 when it has something for the host. */
&brcmf {
	interrupt-parent = <&alive_0>;
	interrupts = <3 IRQ_TYPE_LEVEL_HIGH>;
};

/*
 * HDMI. The boot loader leaves the display blocks in reset: the driver
 * releases the two at the end as well.
 */
&display {
	ddc-i2c-bus = <&i2c_gpio7>;
	enable-gpios = <&gpio_a 21 GPIO_ACTIVE_HIGH>;
	resets = <&nexell_reset 13>, <&nexell_reset 14>,
		 <&nexell_reset 15>, <&nexell_reset 16>,
		 <&nexell_reset 17>, <&nexell_reset 9>,
		 <&nexell_reset 10>;
	reset-names = "hdmi", "hdmi_video", "hdmi_spdif",
		      "hdmi_tmds", "hdmi_phy", "disp_top", "display";
	status = "okay";
};

&spdiftx {
	status = "okay";
};

&i2s0 {
	status = "okay";
};

/* No pull, as in the stock system */
&i2s0_bus {
	nexell,pin-pull = <2>;
};

/*
 * Port 1 has the host PHY, port 2 the HSIC PHY with the hub. The HSIC PHY
 * takes its clock from the OTG PHY, which therefore comes first.
 */
&ehci {
	phys = <&usb2_phy 0>, <&usb2_phy 1>, <&usb2_phy 2>;
	/delete-property/ phy-names;
};

&dwc2 {
	dr_mode = "otg";
	vbus-supply = <&usb_otg_vbus>;
};
