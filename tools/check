#!/bin/sh
# The checks that need no board, the ones CI runs:
#   tools/check lint   shellcheck and actionlint, the Python tool compiles, the
#                      C tests build without a warning
#   tools/check test   tools/install.sh against an image file; the coherency
#                      and load tests, which have to pass on a sound machine;
#                      the self-check of the Zigbee test
#   tools/check        both
set -e
cd "$(dirname "$0")/.."
run() { docker run --rm -v "$PWD":/work "$@"; }

case ${1:-lint} in lint)
	run artik710-builder sh -ec '
		grep -l "^#!/bin/sh" tools/* tests/*.sh | xargs shellcheck --severity=warning
		PYTHONPYCACHEPREFIX=/tmp python3 -m py_compile tools/artik-serial
		for c in tests/*.c; do gcc -O2 -Wall -Wextra -Werror -pthread -o /dev/null "$c"; done'
	run -w /work rhysd/actionlint:1.7.12
esac
case ${1:-test} in test)
	mkdir -p out/tests
	run --privileged artik710-builder sh -ec '
		sh tests/install-test.sh
		for c in tests/*.c; do gcc -O2 -static -pthread -o "out/tests/$(basename "$c" .c)" "$c"; done
		out/tests/smp-coherency 20
		out/tests/cpu-load 2
		out/tests/zigbee-ash -t
		sh tests/stress-integrity.sh 2'
	# reclaim needs a memory limit well below the size of the file
	run --memory=48m artik710-builder out/tests/reclaim-coherency 20 128
esac
